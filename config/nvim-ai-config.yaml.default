# nvim-ai configuration template
# Copy this file to config.yaml and customize

# Default provider (claude|gemini|openai|xai|cursor|codex|auto)
default_provider: auto

# Provider configurations
providers:
  claude:
    # Use CLI or API
    mode: cli  # cli|api

    # CLI configuration
    cli:
      command: claude
      args: []

    # API configuration
    api:
      endpoint: https://api.anthropic.com/v1/messages
      api_key_env: ANTHROPIC_API_KEY
      model: claude-sonnet-4-20250514
      max_tokens: 4096
      temperature: 0.7

  gemini:
    mode: cli  # cli|api
    cli:
      command: gemini
      args: []
    api:
      endpoint: https://generativelanguage.googleapis.com/v1beta/models
      api_key_env: GEMINI_API_KEY
      model: gemini-2.0-flash-exp
      max_tokens: 8192
      temperature: 0.7

  openai:
    mode: api
    api:
      endpoint: https://api.openai.com/v1/chat/completions
      api_key_env: OPENAI_API_KEY
      model: gpt-4o
      max_tokens: 4096
      temperature: 0.7

  xai:
    mode: api
    api:
      endpoint: https://api.x.ai/v1/chat/completions
      api_key_env: XAI_API_KEY
      model: grok-2-1212
      max_tokens: 4096
      temperature: 0.7

  cursor:
    mode: api
    api:
      endpoint: https://api.cursor.sh/v1/chat
      api_key_env: CURSOR_API_KEY
      model: cursor-small
      max_tokens: 4096
      temperature: 0.7

  codex:
    mode: cli
    cli:
      command: openai-cli
      args:
        - --model
        - gpt-4o
    api:
      endpoint: https://api.openai.com/v1/chat/completions
      api_key_env: OPENAI_API_KEY
      model: gpt-4o
      max_tokens: 4096
      temperature: 0.7

# Context settings
context:
  # Maximum file size to include (bytes)
  max_file_size: 1048576  # 1MB

  # File patterns to exclude
  exclude_patterns:
    - "*.min.js"
    - "*.map"
    - "node_modules/**"
    - ".git/**"
    - "dist/**"
    - "build/**"

  # Include git information
  include_git_info: true

  # Include LSP diagnostics if available
  include_diagnostics: true

# Output settings
output:
  # Enable streaming
  stream: true

  # Format (text|json|markdown)
  format: text

  # Color output
  color: true

  # Show thinking process (if supported)
  show_thinking: false

# Cache settings
cache:
  # Enable response caching
  enabled: true

  # Cache TTL in seconds
  ttl: 3600

  # Maximum cache size (MB)
  max_size: 100

